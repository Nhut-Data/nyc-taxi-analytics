# =============================================================
# .env.example — Copy file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).
# =============================================================

# --- Cấu hình Docker Compose / Airflow cơ bản ---

# Đường dẫn thư mục gốc chứa airflow/ trên máy host (thường để '.')
AIRFLOW_PROJ_DIR=.

# UID của user trên máy host, để Airflow container ghi file đúng quyền,
# tránh lỗi permission denied khi mount volume.
# Lấy giá trị thật bằng lệnh: id -u
AIRFLOW_UID=50000

# GCP project ID dùng chung cho toàn bộ pipeline.
GCLOUD_PROJECT=your-gcp-project-id

# --- Secret bắt buộc phải tự sinh, KHÔNG dùng giá trị mẫu ---

# Khoá mã hoá connection/password lưu trong Airflow metadata DB.
# Sinh bằng lệnh:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme_generate_your_own_fernet_key

# Secret ký JWT cho Airflow API (Airflow 3.x). Sinh bằng lệnh:
#   openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=changeme_generate_your_own_jwt_secret

# Issuer của JWT — thường để tên cố định, không phải secret.
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# --- Kết nối GCP (dùng Application Default Credentials, không có secret login/password) ---

# Không chứa secret thật (dùng ADC theo org policy chặn service account key).
# Chỉ cần đổi project ID cho khớp GCLOUD_PROJECT ở trên.
AIRFLOW_CONN_GOOGLE_CLOUD_DEFAULT=google-cloud-platform://?extra__google_cloud_platform__project=your-gcp-project-id

# --- Secret thật, PHẢI tự tạo riêng, không bao giờ commit giá trị thật ---

# Slack Incoming Webhook URL cho pipeline alerting.
# Tạo tại: https://api.slack.com/apps -> chọn app -> Incoming Webhooks -> Add New Webhook
AIRFLOW_VAR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME/PLACEHOLDER