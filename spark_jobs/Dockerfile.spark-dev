
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless \
    wget \
    procps \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Tự tải connector khi build — không commit binary vào git.
# Bản 2.12 khớp Scala version của pyspark==3.5.3 (build trên Scala 2.12).
# Dùng HTTPS public bucket, không cần auth GCP (tránh network restriction gặp trước đây với gsutil).
RUN curl -sSL -o /opt/spark-bigquery-connector.jar \
    https://storage.googleapis.com/spark-lib/bigquery/spark-bigquery-with-dependencies_2.12-0.42.3.jar
ENV SPARK_BQ_JAR=/opt/spark-bigquery-connector.jar

RUN pip install --no-cache-dir \
    pyspark==3.5.3 \
    google-cloud-storage==2.19.0 \
    google-cloud-bigquery==3.33.0 \
    google-auth==2.56.2 \
    pyarrow==15.0.0 \
    requests==2.32.0 \
    pandas==2.2.0 \
    pytest==8.3.0

WORKDIR /app