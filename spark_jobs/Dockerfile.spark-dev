FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless \
    wget \
    procps \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Copy JAR từ host (đã tải sẵn, không wget trong build để tránh network restriction)
COPY spark-bigquery-with-dependencies_2.13-0.42.3.jar /opt/spark-bigquery-connector.jar
ENV SPARK_BQ_JAR=/opt/spark-bigquery-connector.jar

RUN pip install --no-cache-dir \
    pyspark==3.5.3 \
    google-cloud-storage==2.19.0 \
    google-cloud-bigquery==3.33.0 \
    google-auth==2.56.2 \
    pyarrow==15.0.0 \
    requests==2.32.0 \
    pandas==2.2.0 \
    pytest==8.3.0

WORKDIR /app
